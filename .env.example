# Copy to .env and adjust. Never commit .env.

# Database (PostgreSQL 17)
POSTGRES_USER=nexora
POSTGRES_PASSWORD=nexora
POSTGRES_DB=nexora
DATABASE_URL=postgresql://nexora:nexora@localhost:5432/nexora?schema=public

# Redis (cache and BullMQ jobs)
REDIS_URL=redis://localhost:6379

# Authentication
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_TTL=7d

# Object storage (MinIO locally, S3 in production)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=nexora
S3_SECRET_KEY=nexora-secret
S3_BUCKET=nexora-files

# Email (Mailpit locally: web UI on http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Nexora ERP <no-reply@nexora.local>"

# Apps
API_PORT=4000
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Monitoring (optional)
SENTRY_DSN=
